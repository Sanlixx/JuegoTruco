<mxfile host="app.diagrams.net"><diagram id="truco-clases" name="Diagrama de clases"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="3600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="pkg_main" value="ar.edu.unlu.poo" style="shape=folder;fontStyle=1;tabWidth=300;tabHeight=26;tabPosition=left;html=1;boundedLbl=1;labelInHeader=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;opacity=40;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="243" height="182" as="geometry" /></mxCell><mxCell id="pkg_vista" value="ar.edu.unlu.poo.vista" style="shape=folder;fontStyle=1;tabWidth=300;tabHeight=26;tabPosition=left;html=1;boundedLbl=1;labelInHeader=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=40;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="272" width="608" height="798" as="geometry" /></mxCell><mxCell id="pkg_ctrl" value="ar.edu.unlu.poo.controlador" style="shape=folder;fontStyle=1;tabWidth=300;tabHeight=26;tabPosition=left;html=1;boundedLbl=1;labelInHeader=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;opacity=40;fontSize=13;" vertex="1" parent="1"><mxGeometry x="738" y="272" width="492" height="689" as="geometry" /></mxCell><mxCell id="pkg_obs" value="ar.edu.unlu.poo.observer" style="shape=folder;fontStyle=1;tabWidth=300;tabHeight=26;tabPosition=left;html=1;boundedLbl=1;labelInHeader=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;opacity=40;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1340" y="90" width="855" height="563" as="geometry" /></mxCell><mxCell id="pkg_modelo" value="ar.edu.unlu.poo.truco  (MODELO)" style="shape=folder;fontStyle=1;tabWidth=300;tabHeight=26;tabPosition=left;html=1;boundedLbl=1;labelInHeader=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=40;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="1190" width="2457" height="1717" as="geometry" /></mxCell><mxCell id="c_Main" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Main&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;div style=&quot;height:2px;&quot;&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ main(args: String[]): void&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Arrancar la aplicación: crea la vista y el controlador y los conecta.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="203" height="112" as="geometry" /></mxCell><mxCell id="c_VistaConsola" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;VistaConsola&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- scanner: Scanner&lt;br/&gt;- controlador: Controlador&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ setControlador(controlador: Controlador): void&lt;br/&gt;+ iniciar(): void&lt;br/&gt;- mostrarMenuTurno(): void&lt;br/&gt;- mostrarMenuRespuesta(): void&lt;br/&gt;+ mostrarInicioRonda(jugadorMano: String): void&lt;br/&gt;+ mostrarMarcador(equipoA: String, puntosA: int, equipoB: String, puntosB: int): void&lt;br/&gt;+ mostrarCartaJugada(jugador: String, carta: String): void&lt;br/&gt;+ mostrarGanadorBaza(jugador: String): void&lt;br/&gt;+ mostrarBazaParda(): void&lt;br/&gt;+ mostrarCanto(jugador: String, canto: String): void&lt;br/&gt;+ mostrarRespuesta(jugador: String, respuesta: String): void&lt;br/&gt;+ mostrarResultadoEnvido(equipo: String, tanto: int, puntos: int): void&lt;br/&gt;+ mostrarPuntosNoQuerido(equipo: String, puntos: int): void&lt;br/&gt;+ mostrarJugadorAlMazo(jugador: String): void&lt;br/&gt;+ mostrarGanadorRonda(equipo: String, puntos: int): void&lt;br/&gt;+ mostrarGanadorPartida(equipo: String): void&lt;br/&gt;+ mostrarError(mensaje: String): void&lt;br/&gt;- pedirTexto(mensaje: String): String&lt;br/&gt;- pedirPuntosParaGanar(): int&lt;br/&gt;- esNumero(texto: String): boolean&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Pedir los datos y las opciones por teclado y mostrar en consola lo que le indica el controlador. No conoce al modelo.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="568" height="378" as="geometry" /></mxCell><mxCell id="c_IVista" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;IVista&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;div style=&quot;height:2px;&quot;&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ setControlador(controlador: Controlador): void&lt;br/&gt;+ iniciar(): void&lt;br/&gt;+ mostrarInicioRonda(jugadorMano: String): void&lt;br/&gt;+ mostrarMarcador(equipoA: String, puntosA: int, equipoB: String, puntosB: int): void&lt;br/&gt;+ mostrarCartaJugada(jugador: String, carta: String): void&lt;br/&gt;+ mostrarGanadorBaza(jugador: String): void&lt;br/&gt;+ mostrarBazaParda(): void&lt;br/&gt;+ mostrarCanto(jugador: String, canto: String): void&lt;br/&gt;+ mostrarRespuesta(jugador: String, respuesta: String): void&lt;br/&gt;+ mostrarResultadoEnvido(equipo: String, tanto: int, puntos: int): void&lt;br/&gt;+ mostrarPuntosNoQuerido(equipo: String, puntos: int): void&lt;br/&gt;+ mostrarJugadorAlMazo(jugador: String): void&lt;br/&gt;+ mostrarGanadorRonda(equipo: String, puntos: int): void&lt;br/&gt;+ mostrarGanadorPartida(equipo: String): void&lt;br/&gt;+ mostrarError(mensaje: String): void&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Definir lo que el controlador le puede pedir a cualquier pantalla (consola o gráfica).&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="568" height="300" as="geometry" /></mxCell><mxCell id="c_Controlador" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Controlador&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- vista: IVista&lt;br/&gt;- modelo: JuegoTruco&lt;br/&gt;- respondedorElegido: Jugador&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Controlador(vista: IVista)&lt;br/&gt;+ iniciarPartida(nombres: List&amp;lt;String&amp;gt;, puntosParaGanar: int): void&lt;br/&gt;+ jugarCarta(indiceCarta: int): void&lt;br/&gt;+ elegirRespondedor(numero: int): boolean&lt;br/&gt;+ cantarTruco(): void&lt;br/&gt;+ cantarEnvido(): void&lt;br/&gt;+ cantarRealEnvido(): void&lt;br/&gt;+ cantarFaltaEnvido(): void&lt;br/&gt;- cantarEnvido(tipo: TipoApuesta): void&lt;br/&gt;+ quiero(): void&lt;br/&gt;+ noQuiero(): void&lt;br/&gt;+ irseAlMazo(): void&lt;br/&gt;+ isPartidaTerminada(): boolean&lt;br/&gt;+ getJugadorQueDebeActuar(): String&lt;br/&gt;+ getCartasDelJugadorQueDebeActuar(): List&amp;lt;String&amp;gt;&lt;br/&gt;+ getCompanero(): String&lt;br/&gt;+ getCartasDelCompanero(): List&amp;lt;String&amp;gt;&lt;br/&gt;+ getCartasEnLaMesa(): List&amp;lt;String&amp;gt;&lt;br/&gt;+ getNumeroBaza(): int&lt;br/&gt;+ hayCantoPendiente(): boolean&lt;br/&gt;+ hayTrucoPendiente(): boolean&lt;br/&gt;+ hayEnvidoPendiente(): boolean&lt;br/&gt;+ getJugadorQueCanto(): String&lt;br/&gt;+ getEquipoQueResponde(): String&lt;br/&gt;+ getRivalesQuePuedenResponder(): List&amp;lt;String&amp;gt;&lt;br/&gt;+ getCartasDeRival(numero: int): List&amp;lt;String&amp;gt;&lt;br/&gt;+ getCantoPendiente(): String&lt;br/&gt;+ sePuedeCantarTruco(): boolean&lt;br/&gt;+ getProximoCantoTruco(): String&lt;br/&gt;+ sePuedeCantarEnvido(): boolean&lt;br/&gt;+ actualizar(evento: Evento, observable: IObservable): void&lt;br/&gt;- jugadorQueActua(): Jugador&lt;br/&gt;- companeroDelQueActua(): Jugador&lt;br/&gt;- mostrarMarcador(): void&lt;br/&gt;- textoTruco(estado: EstadoTruco): String&lt;br/&gt;- textoEnvido(tipo: TipoApuesta): String&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Recibir las acciones de la vista y pedírselas al modelo. Observar al modelo y, ante cada evento, decirle a la vista qué mostrar. Traducir los objetos del modelo a textos.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;rounded=0;" vertex="1" parent="1"><mxGeometry x="758" y="322" width="452" height="619" as="geometry" /></mxCell><mxCell id="c_Evento" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Evento&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;INICIO_RONDA&lt;br/&gt;CARTA_JUGADA&lt;br/&gt;CAMBIO_TURNO&lt;br/&gt;BAZA_TERMINADA&lt;br/&gt;TRUCO_CANTADO&lt;br/&gt;TRUCO_QUERIDO&lt;br/&gt;TRUCO_NO_QUERIDO&lt;br/&gt;ENVIDO_CANTADO&lt;br/&gt;ENVIDO_QUERIDO&lt;br/&gt;ENVIDO_NO_QUERIDO&lt;br/&gt;JUGADOR_AL_MAZO&lt;br/&gt;RONDA_TERMINADA&lt;br/&gt;PARTIDA_TERMINADA&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Enumerar los cambios que el modelo informa a sus observadores.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1360" y="140" width="200" height="284" as="geometry" /></mxCell><mxCell id="c_IObservador" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;IObservador&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;div style=&quot;height:2px;&quot;&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ actualizar(evento: Evento, observable: IObservable): void&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Recibir los avisos (eventos) de un observable.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1360" y="494" width="401" height="112" as="geometry" /></mxCell><mxCell id="c_IObservable" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;IObservable&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;div style=&quot;height:2px;&quot;&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ agregarObservador(observador: IObservador): void&lt;br/&gt;+ quitarObservador(observador: IObservador): void&lt;br/&gt;+ notificarObservadores(evento: Evento): void&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Permitir que otros objetos se suscriban y avisarles cada cambio.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;rounded=0;" vertex="1" parent="1"><mxGeometry x="1831" y="494" width="344" height="139" as="geometry" /></mxCell><mxCell id="c_Partida" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Partida&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;- CARTAS_POR_JUGADOR: int&lt;/u&gt;&lt;br/&gt;- equipoA: Equipo&lt;br/&gt;- equipoB: Equipo&lt;br/&gt;- mazo: Mazo&lt;br/&gt;- ordenMesa: List&amp;lt;Jugador&amp;gt;&lt;br/&gt;- indiceMano: int&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Partida(equipoA: Equipo, equipoB: Equipo)&lt;br/&gt;+ getOrdenMesa(): List&amp;lt;Jugador&amp;gt;&lt;br/&gt;+ getJugadorMano(): Jugador&lt;br/&gt;+ pasarMano(): void&lt;br/&gt;+ repartirCartas(): void&lt;br/&gt;+ sumarPuntosEquipoA(puntos: int): void&lt;br/&gt;+ sumarPuntosEquipoB(puntos: int): void&lt;br/&gt;+ resolverEnvido(): Equipo&lt;br/&gt;- desempatarPorCercaniaALaMano(puntosEmpatados: int): Equipo&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Mantener el orden de la mesa y quién es mano. Repartir las cartas. Resolver qué equipo gana el envido (con desempate por cercanía a la mano).&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="80" y="1280" width="408" height="297" as="geometry" /></mxCell><mxCell id="c_RondaTruco" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;RondaTruco&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- equipoA: Equipo&lt;br/&gt;- equipoB: Equipo&lt;br/&gt;- jugadorMano: Jugador&lt;br/&gt;- historialBazas: List&amp;lt;Baza&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ RondaTruco(equipoA: Equipo, equipoB: Equipo, jugadorMano: Jugador)&lt;br/&gt;+ registrarBaza(baza: Baza): void&lt;br/&gt;+ determinarGanadorRonda(): Equipo&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Registrar las bazas de una ronda y determinar el equipo ganador, incluidas las pardas.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="80" y="1627" width="459" height="177" as="geometry" /></mxCell><mxCell id="c_Baza" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Baza&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- jugadas: List&amp;lt;CartaJugada&amp;gt;&lt;br/&gt;- reglas: ReglasTruco&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Baza()&lt;br/&gt;+ jugarCarta(jugador: Jugador, carta: Carta): void&lt;br/&gt;+ determinarGanadorDirecto(equipoA: Equipo, equipoB: Equipo): Equipo&lt;br/&gt;+ determinarJugadorGanador(equipoA: Equipo, equipoB: Equipo): Jugador&lt;br/&gt;+ getJugadas(): List&amp;lt;CartaJugada&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Registrar las cartas jugadas en una baza y determinar el equipo y el jugador ganador, o si fue parda.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="80" y="1854" width="465" height="177" as="geometry" /></mxCell><mxCell id="c_CartaJugada" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;CartaJugada&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- jugador: Jugador&lt;br/&gt;- carta: Carta&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ CartaJugada(jugador: Jugador, carta: Carta)&lt;br/&gt;+ getJugador(): Jugador&lt;br/&gt;+ getCarta(): Carta&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Asociar una carta con el jugador que la tiró.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="80" y="2081" width="312" height="150" as="geometry" /></mxCell><mxCell id="c_ReglasTruco" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ReglasTruco&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;div style=&quot;height:2px;&quot;&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ obtenerFuerza(carta: Carta): int&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Conocer la jerarquía (fuerza) de cada carta en el truco.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="80" y="2281" width="241" height="112" as="geometry" /></mxCell><mxCell id="c_JuegoTruco" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;JuegoTruco&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;+ CARTAS_POR_BAZA: int&lt;/u&gt;&lt;br/&gt;&lt;u&gt;+ BAZAS_POR_RONDA: int&lt;/u&gt;&lt;br/&gt;&lt;u&gt;+ PUNTOS_MALAS: int&lt;/u&gt;&lt;br/&gt;- observadores: List&amp;lt;IObservador&amp;gt;&lt;br/&gt;- equipoA: Equipo&lt;br/&gt;- equipoB: Equipo&lt;br/&gt;- partida: Partida&lt;br/&gt;- puntosParaGanar: int&lt;br/&gt;- rondaActual: RondaTruco&lt;br/&gt;- bazaActual: Baza&lt;br/&gt;- numeroBaza: int&lt;br/&gt;- indiceTurno: int&lt;br/&gt;- cantoPendiente: CantoPendiente&lt;br/&gt;- jugadorQueCanto: Jugador&lt;br/&gt;- equipoQueResponde: Equipo&lt;br/&gt;- jugadorQueRespondio: Jugador&lt;br/&gt;- apuestaTruco: ApuestaTruco&lt;br/&gt;- equipoQuePuedeSubirTruco: Equipo&lt;br/&gt;- apuestaEnvido: ApuestaEnvido&lt;br/&gt;- envidoYaJugado: boolean&lt;br/&gt;- ultimaCartaJugada: CartaJugada&lt;br/&gt;- ganadorUltimaBaza: Jugador&lt;br/&gt;- ganadorUltimaRonda: Equipo&lt;br/&gt;- puntosUltimaRonda: int&lt;br/&gt;- ganadorUltimoEnvido: Equipo&lt;br/&gt;- puntosUltimoEnvido: int&lt;br/&gt;- ultimoJugadorAlMazo: Jugador&lt;br/&gt;- ganadorPartida: Equipo&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ JuegoTruco(equipoA: Equipo, equipoB: Equipo, puntosParaGanar: int)&lt;br/&gt;+ iniciar(): void&lt;br/&gt;+ jugarCarta(indiceCarta: int): void&lt;br/&gt;+ cantarTruco(cantor: Jugador): void&lt;br/&gt;+ cantarEnvido(cantor: Jugador, tipo: TipoApuesta): void&lt;br/&gt;+ quiero(quienResponde: Jugador): void&lt;br/&gt;+ noQuiero(quienResponde: Jugador): void&lt;br/&gt;+ irseAlMazo(): void&lt;br/&gt;- iniciarRonda(): void&lt;br/&gt;- terminarBaza(): void&lt;br/&gt;- terminarRonda(ganador: Equipo, puntos: int): void&lt;br/&gt;- verificarFinDePartida(): boolean&lt;br/&gt;- puntosEnvidoQuerido(): int&lt;br/&gt;- calcularFaltaEnvido(): int&lt;br/&gt;- esperarRespuesta(canto: CantoPendiente, cantor: Jugador): void&lt;br/&gt;- limpiarCantoPendiente(): void&lt;br/&gt;- validarQuePuedeActuar(jugador: Jugador): void&lt;br/&gt;- validarQueHayCantoPendiente(): void&lt;br/&gt;- validarPartidaEnCurso(): void&lt;br/&gt;- siguienteIndice(indice: int): int&lt;br/&gt;- equipoDe(jugador: Jugador): Equipo&lt;br/&gt;- rivalDe(equipo: Equipo): Equipo&lt;br/&gt;+ getJugadorEnTurno(): Jugador&lt;br/&gt;+ getEquipoQueResponde(): Equipo&lt;br/&gt;+ getJugadoresQuePuedenResponder(): List&amp;lt;Jugador&amp;gt;&lt;br/&gt;+ hayCantoPendiente(): boolean&lt;br/&gt;+ getCantoPendiente(): CantoPendiente&lt;br/&gt;+ getJugadorQueCanto(): Jugador&lt;br/&gt;+ getJugadorQueRespondio(): Jugador&lt;br/&gt;+ sePuedeCantarTruco(): boolean&lt;br/&gt;+ getEstadoTruco(): EstadoTruco&lt;br/&gt;+ getUltimoEnvidoCantado(): TipoApuesta&lt;br/&gt;+ sePuedeCantarEnvido(): boolean&lt;br/&gt;+ esPie(jugador: Jugador): boolean&lt;br/&gt;+ getEquipoA(): Equipo&lt;br/&gt;+ getEquipoB(): Equipo&lt;br/&gt;+ getEquipoDe(jugador: Jugador): Equipo&lt;br/&gt;+ getOrdenMesa(): List&amp;lt;Jugador&amp;gt;&lt;br/&gt;+ getJugadorMano(): Jugador&lt;br/&gt;+ getNumeroBaza(): int&lt;br/&gt;+ getCartasDeLaBazaActual(): List&amp;lt;CartaJugada&amp;gt;&lt;br/&gt;+ getUltimaCartaJugada(): CartaJugada&lt;br/&gt;+ getGanadorUltimaBaza(): Jugador&lt;br/&gt;+ getGanadorUltimaRonda(): Equipo&lt;br/&gt;+ getPuntosUltimaRonda(): int&lt;br/&gt;+ getGanadorUltimoEnvido(): Equipo&lt;br/&gt;+ getPuntosUltimoEnvido(): int&lt;br/&gt;+ getUltimoJugadorAlMazo(): Jugador&lt;br/&gt;+ getPuntosParaGanar(): int&lt;br/&gt;+ isPartidaTerminada(): boolean&lt;br/&gt;+ getGanadorPartida(): Equipo&lt;br/&gt;+ agregarObservador(observador: IObservador): void&lt;br/&gt;+ quitarObservador(observador: IObservador): void&lt;br/&gt;+ notificarObservadores(evento: Evento): void&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Coordinar el flujo de la partida: turnos, bazas, rondas, cantos y fin de partida. Validar que cada acción sea válida en ese momento. Notificar a los observadores cada cambio.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="695" y="1280" width="459" height="1195" as="geometry" /></mxCell><mxCell id="c_Equipo" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Equipo&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- nombreEquipo: String&lt;br/&gt;- jugador1: Jugador&lt;br/&gt;- jugador2: Jugador&lt;br/&gt;- puntos: int&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Equipo(nombreEquipo: String, jugador1: Jugador, jugador2: Jugador)&lt;br/&gt;+ getNombre(): String&lt;br/&gt;+ sumarPuntos(puntos: int): void&lt;br/&gt;+ getPuntos(): int&lt;br/&gt;+ getJugadores(): List&amp;lt;Jugador&amp;gt;&lt;br/&gt;+ getCompaneroDe(jugador: Jugador): Jugador&lt;br/&gt;+ getMejorEnvido(): int&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Agrupar a los dos jugadores, acumular los puntos, conocer el mejor envido del equipo y el compañero de cada jugador.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="1304" y="1280" width="459" height="230" as="geometry" /></mxCell><mxCell id="c_Jugador" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Jugador&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;&lt;u&gt;- CARTAS_POR_MANO: int&lt;/u&gt;&lt;br/&gt;- nombre: String&lt;br/&gt;- manoRepartida: List&amp;lt;Carta&amp;gt;&lt;br/&gt;- cartasEnMano: List&amp;lt;Carta&amp;gt;&lt;br/&gt;- calculadorEnvido: CalculadorEnvido&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Jugador(nombre: String)&lt;br/&gt;+ getNombre(): String&lt;br/&gt;+ recibirCarta(carta: Carta): void&lt;br/&gt;+ jugarCarta(indice: int): Carta&lt;br/&gt;+ obtenerPuntosEnvido(): int&lt;br/&gt;+ getCartasEnMano(): List&amp;lt;Carta&amp;gt;&lt;br/&gt;+ vaciarMano(): void&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Guardar su mano, jugar cartas y calcular sus puntos de envido.&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="1304" y="1560" width="254" height="257" as="geometry" /></mxCell><mxCell id="c_Carta" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Carta&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- numero: int&lt;br/&gt;- palo: Palo&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Carta(numero: int, palo: Palo)&lt;br/&gt;+ getNumero(): int&lt;br/&gt;+ getPalo(): Palo&lt;br/&gt;- esNumeroValido(numero: int): boolean&lt;br/&gt;+ toString(): String&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;margin-right:6px;&quot;&gt;&lt;i&gt;Responsabilidad: Representar una carta válida para el truco (número y palo).&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=0;" vertex="1" parent="1"><mxGeometry x="1304" y="1867" width="267" height="177" as="geometry" /></mxCell><mxCell id="c_Mazo" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Mazo&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margi